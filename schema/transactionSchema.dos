module DolphinDBScript::ExchTDFData::schema::transactionSchema

def TransactionCsvSchema(){

    name = ['code',
    'wind_code',
    'name',
    'date',
    'time',
    'function_code',
    'order_kind',
    'bs_flag',
    'trade_price',
    'trade_volume',
    'ask_order',
    'bid_order',
    'channel',
    'index',
    'biz_index'];

    type = ['SYMBOL',
    'SYMBOL',
    'SYMBOL',
    'DATE',
    'LONG',
    'LONG',
    'LONG',
    'LONG',
    'LONG',
    'LONG',
    'LONG',
    'LONG',
    'LONG',
    'LONG',
    'LONG'];

    schemaTable = table(name, type)
    return schemaTable

};

