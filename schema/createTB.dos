	};
};

def createTransaction(dbName, tbName){
	db = database(dbName);
	if(existsTable(dbName, tbName)){
		errorMessage = dict(`message`code, ["Database [" + dbName + "] already exists table [" + tbName + "]", "warning"]);
		writeLog(toStdJson(errorMessage));
		print(toStdJson(errorMessage));
		return false;
	};	
	schemaTable = TransactionSchema();
	try{	
		db.createPartitionedTable(table=schemaTable, tableName=tbName, partitionColumns=`date`wind_code, compressMethods={OrigTime:"delta"}, sortColumns=`wind_code`date`time, keepDuplicates=ALL)}
	catch(ex){
		errorMessage = dict(`message`code, ["DFSTable [" + dbName + ", " + tbName + "] create Failed！", "error"]);
		writeLog(toStdJson(errorMessage));
		print(toStdJson(errorMessage));
	};
};


def createTB(dbName,tbName,dataType,initialDB=false,initialTB=false){
	createDB(dbName,initialDB);
	if(initialTB==true){
		writeLog("Start drop the table [" + tbName + "] in the database [" + dbName + "].");
		print("Start drop the table [" + tbName + "] in the database [" + dbName + "].");
		try{dropTable(database(dbName), tbName)}catch(ex){print(ex)};		
	}
	if (!existsTable(dbName, tbName)){
		writeLog("Start create the table [" + tbName + "] in the database [" + dbName + "].");
		print("Start create the table [" + tbName + "] in the database [" + dbName + "].");
		
		if (dataType.lower() == "tick"){
			createTick(dbName, tbName);
		}
		else if (dataType.lower()  == "order"){
			createOrder(dbName,tbName);
		}
		else if (dataType.lower()  == "orderqueue"){
			createOrderQueue(dbName,tbName);
		}
        else if (dataType.lower()  == "transaction"){
			createTransaction(dbName,tbName);
		}
	}
}

