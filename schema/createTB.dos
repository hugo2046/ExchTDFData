		return false
	};	
	schemaTable = OrderSchema();
	try{	
		db.createPartitionedTable(table=schemaTable, tableName=tbName, partitionColumns=`date`wind_code, compressMethods={OrderTime:"delta"}, sortColumns=`wind_code`date`time, keepDuplicates=ALL);
	}
	catch(ex){
		errorMessage = dict(`message`code, ["DFSTable [" + dbName + ", " + tbName + "] create Failed！", "error"]);
        writeLog(toStdJson(errorMessage));
        print(toStdJson(errorMessage));
	};
};

def createOrderQueue(dbName, tbName){
	db = database(dbName);
	if(existsTable(dbName, tbName)){
		errorMessage = dict(`message`code, ["Database [" + dbName + "] already exists table [" + tbName + "]", "warning"]);
		writeLog(toStdJson(errorMessage));
		print(toStdJson(errorMessage));
		return false;
	};	
	schemaTable = OrderQueueSchema();
	try{	
		db.createPartitionedTable(table=schemaTable, tableName=tbName, partitionColumns=`date`wind_code, compressMethods={OrigTime:"delta"}, sortColumns=`wind_code`date`time, keepDuplicates=ALL)}
	catch(ex){
		errorMessage = dict(`message`code, ["DFSTable [" + dbName + ", " + tbName + "] create Failed！", "error"])
		writeLog(toStdJson(errorMessage))
